{
  "name": "antartalk-doctor-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared AntarTalk API for doctor operations and conflict-safe client bookings.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "lint": "eslint src tests",
    "typecheck": "tsc --project tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.10",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.35.0",
    "prisma": "^6.12.0",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
