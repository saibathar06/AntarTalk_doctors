NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/antartalk
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-32-random-characters
PAYOUT_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=replace-with-brevo-smtp-user
SMTP_PASS=replace-with-brevo-smtp-key
EMAIL_FROM=AntarTalk <verified-sender@example.com>

RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
RAZORPAY_CURRENCY=INR
PLATFORM_COMMISSION_PERCENT=20
DOCTOR_SAME_DAY_CANCELLATION_PENALTY_PERCENT=5
BOOKING_TRANSACTION_TIMEOUT_MS=20000
MIN_SESSION_ATTENDANCE_MINUTES=5

# Optional Expo access token; keep PUSH_DELIVERY_ENABLED=true to process queued pushes.
EXPO_ACCESS_TOKEN=
PUSH_DELIVERY_ENABLED=true

# Deploy antartalk-video-team-handoff as its own private/trusted service.
VIDEO_SERVICE_URL=https://video.example.com
VIDEO_SERVICE_API_KEY=replace-with-the-same-32-character-video-service-key
VIDEO_REQUEST_TIMEOUT_MS=10000
DOCTOR_WEB_ORIGIN=http://127.0.0.1:5173
CLIENT_WEB_ORIGIN=http://127.0.0.1:5173
