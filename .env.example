NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/antartalk?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# 32 random bytes encoded as 64 hex characters; required for payout account creation.
# PAYOUT_ENCRYPTION_KEY=
# Explicit trusted proxy IPs/CIDRs only; empty means direct connections.
TRUST_PROXY=
JOIN_EARLY_MINUTES=10
OTP_PEPPER=replace-with-a-third-at-least-32-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@antartalk.com
RESERVATION_TTL_SECONDS=180
SESSION_DURATION_MINUTES=40
BUFFER_DURATION_MINUTES=20
SLOT_INTERVAL_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=info
