generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  DOCTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum ProfessionalCategory {
  PSYCHIATRIST
  PSYCHOLOGIST
  COUNSELLOR
}

enum ProfessionalStatus {
  LICENSED_PROFESSIONAL
  FINAL_YEAR_STUDENT
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  DOCTOR_LOGIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  REVERSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutAccountType {
  BANK_ACCOUNT
  UPI
}

enum PushPlatform {
  IOS
  ANDROID
}

enum NotificationType {
  SESSION_BOOKED
  SESSION_CANCELLED
  SESSION_REMINDER
  RESCHEDULE_REQUESTED
  SESSION_RESCHEDULED
  RESCHEDULE_REJECTED
  REFUND_PROCESSED
}

enum CancellationActor {
  CLIENT
  DOCTOR
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum VideoCallState {
  PENDING
  SCHEDULED
  ENDED
  CANCELLED
  FAILED
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  email                 String        @unique @db.VarChar(320)
  firstName             String?       @db.VarChar(100)
  lastName              String?       @db.VarChar(100)
  dateOfBirth           DateTime?     @db.Date
  passwordHash          String
  role                   UserRole
  accountStatus          AccountStatus @default(ACTIVE)
  emailVerifiedAt        DateTime?     @db.Timestamptz(3)
  tokenVersion           Int           @default(0)
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?     @db.Timestamptz(3)
  doctorProfile          DoctorProfile?
  clientBookings         Booking[]     @relation("ClientBookings")
  refreshTokens          RefreshToken[]
  otpChallenges          OtpChallenge[]
  idempotencyRecords     IdempotencyRecord[]
  auditLogs              AuditLog[]    @relation("AuditActor")
  payments               Payment[]     @relation("ClientPayments")
  pushDevices            PushDevice[]
  notifications          Notification[]
  rescheduleRequests     RescheduleRequest[] @relation("RescheduleRequester")
  prescriptions          Prescription[]
}

model DoctorProfile {
  id                       String               @id @default(uuid()) @db.Uuid
  userId                   String               @unique @db.Uuid
  firstName                String               @db.VarChar(100)
  lastName                 String               @db.VarChar(100)
  dateOfBirth              DateTime             @db.Date
  gender                   Gender?
  phoneNumber              String               @unique @db.VarChar(32)
  professionalCategory     ProfessionalCategory
  professionalStatus       ProfessionalStatus
  verificationStatus       VerificationStatus   @default(PENDING)
  verificationSubmittedAt  DateTime?            @db.Timestamptz(3)
  verificationReason       String?              @db.VarChar(500)
  licenseNumber            String?              @unique @db.VarChar(100)
  licenseAuthority         String?              @db.VarChar(160)
  university               String?              @db.VarChar(200)
  course                   String?              @db.VarChar(200)
  specialization           String?              @db.VarChar(200)
  expectedGraduationDate   DateTime?            @db.Date
  enrollmentNumber         String?              @db.VarChar(100)
  timezone                 String               @default("Asia/Kolkata") @db.VarChar(64)
  bio                      String?              @db.VarChar(2000)
  profileImageUrl           String?              @db.VarChar(300)
  licenseDocumentUrl        String?              @db.VarChar(300)
  qualification            String?              @db.VarChar(200)
  institution              String?              @db.VarChar(200)
  graduationYear           Int?
  experienceYears          Int?
  languages                String[]             @default([])
  preferredSessionLanguage String?              @db.VarChar(80)
  expertise                String[]             @default([])
  consultationFee          Decimal?             @db.Decimal(12, 2)
  emailNotifications       Boolean              @default(true)
  isAcceptingBookings      Boolean              @default(false)
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)
  user                     User                 @relation(fields: [userId], references: [id])
  workingHours             DoctorWorkingHour[]
  availabilityPresets      Json                 @default("[]")
  photo                    DoctorPhoto?
  stampSignature           DoctorSignature?
  credentialDocument       DoctorCredentialDocument?
  blockedSlots             DoctorBlockedSlot[]
  bookings                 Booking[]
  earnings                 Earning[]
  payoutAccounts           PayoutAccount[]
  payouts                  PayoutTransaction[]
  paymentOrders            Payment[] @relation("PaymentOrderDoctor")
  penalties                DoctorPenalty[]
  prescriptions            Prescription[]

  @@index([verificationStatus, isAcceptingBookings])
}

model DoctorCredentialDocument {
  doctorId  String        @id @db.Uuid
  data      Bytes
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model OtpChallenge {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  purpose      OtpPurpose
  otpHash      String
  attempts     Int        @default(0)
  expiresAt    DateTime   @db.Timestamptz(3)
  lastSentAt   DateTime   @default(now()) @db.Timestamptz(3)
  consumedAt   DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  familyId       String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  replacedByHash String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model DoctorWorkingHour {
  id          String        @id @default(uuid()) @db.Uuid
  doctorId    String        @db.Uuid
  dayOfWeek   Int
  availableDate DateTime?    @db.Date
  startTime   DateTime      @db.Time(0)
  endTime     DateTime      @db.Time(0)
  timezone    String        @db.VarChar(64)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, isActive])
  @@index([availableDate, isActive, doctorId])
}

model DoctorBlockedSlot {
  id          String        @id @default(uuid()) @db.Uuid
  doctorId    String        @db.Uuid
  startTime   DateTime      @db.Timestamptz(3)
  endTime     DateTime      @db.Timestamptz(3)
  reason      String?       @db.VarChar(500)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startTime, endTime])
}

model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  doctorId              String        @db.Uuid
  clientId              String        @db.Uuid
  clientName            String?       @db.VarChar(200)
  clientAge             Int?
  startTime             DateTime      @db.Timestamptz(3)
  endTime               DateTime      @db.Timestamptz(3)
  sessionDurationMinutes Int
  bufferDurationMinutes  Int
  status                BookingStatus @default(PENDING)
  paymentId             String?       @unique @db.Uuid
  reservationExpiresAt  DateTime?      @db.Timestamptz(3)
  cancelledAt           DateTime?     @db.Timestamptz(3)
  cancelledBy           CancellationActor?
  cancellationReason    String?       @db.VarChar(500)
  completedAt           DateTime?     @db.Timestamptz(3)
  rescheduleCount       Int           @default(0)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  doctor                DoctorProfile @relation(fields: [doctorId], references: [id])
  client                User          @relation("ClientBookings", fields: [clientId], references: [id])
  payment               Payment?      @relation(fields: [paymentId], references: [id])
  earning               Earning?
  confirmationEmails    BookingEmail[]
  videoCall             VideoCall?
  refund                RefundTransaction?
  penalty               DoctorPenalty?
  rescheduleRequests    RescheduleRequest[]
  prescription          Prescription?

  @@index([doctorId, startTime])
  @@index([clientId, startTime])
}

model PushDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(300)
  platform   PushPlatform
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId, isActive])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(120)
  body       String           @db.VarChar(300)
  data       Json
  readAt     DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId, readAt, createdAt])
}

model PushDelivery {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @db.Uuid
  deviceId       String       @db.Uuid
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @db.Timestamptz(3)
  sentAt         DateTime?    @db.Timestamptz(3)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device         PushDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
  @@index([sentAt, nextAttemptAt])
}

model VideoCall {
  id               String         @id @default(uuid()) @db.Uuid
  bookingId        String         @unique @db.Uuid
  serviceSessionId String?        @unique @db.VarChar(128)
  opensAt          DateTime       @db.Timestamptz(3)
  closesAt         DateTime       @db.Timestamptz(3)
  state            VideoCallState @default(PENDING)
  attempts         Int            @default(0)
  nextAttemptAt    DateTime       @default(now()) @db.Timestamptz(3)
  lastErrorCode    String?        @db.VarChar(80)
  doctorJoinedAt   DateTime?      @db.Timestamptz(3)
  clientJoinedAt   DateTime?      @db.Timestamptz(3)
  concurrentSeconds Int           @default(0)
  attendanceFinalizedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([state, nextAttemptAt])
  @@index([attendanceFinalizedAt, closesAt])
}

model DoctorPhoto {
  doctorId String @id @db.Uuid
  data Bytes
  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// A psychiatrist's stamp/signature is private, durable clinical data. It is never
// served as a public upload and is embedded only into a prescription they issue.
model DoctorSignature {
  doctorId  String        @id @db.Uuid
  data      Bytes
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Prescription {
  id           String        @id @default(uuid()) @db.Uuid
  bookingId    String        @unique @db.Uuid
  doctorId     String        @db.Uuid
  clientId     String        @db.Uuid
  medicines    String        @db.Text
  instructions String?       @db.Text
  pdfData      Bytes
  issuedAt     DateTime      @default(now()) @db.Timestamptz(3)
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  client       User          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  email        PrescriptionEmail?

  @@index([doctorId, issuedAt])
  @@index([clientId, issuedAt])
}

// The generated PDF stays in PostgreSQL; a retryable delivery row makes SMTP
// outages recoverable without regenerating or changing the clinical record.
model PrescriptionEmail {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @unique @db.Uuid
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @db.Timestamptz(3)
  sentAt         DateTime?    @db.Timestamptz(3)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([sentAt, nextAttemptAt])
}

model BookingEmail {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid
  audience String @db.VarChar(10)
  kind String @default("CONFIRMATION") @db.VarChar(40)
  eventKey String @default("initial") @db.VarChar(80)
  eventData Json?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@unique([bookingId, audience, kind, eventKey])
  @@index([sentAt, nextAttemptAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  clientId          String        @db.Uuid
  doctorId          String?       @db.Uuid
  doctor            DoctorProfile? @relation("PaymentOrderDoctor", fields: [doctorId], references: [id], onDelete: Restrict, map: "Payment_order_doctor_fk")
  slotStart         DateTime?     @db.Timestamptz(3)
  slotEnd           DateTime?     @db.Timestamptz(3)
  expectedAmount    Decimal?      @db.Decimal(12, 2)
  expectedCurrency  String?       @db.Char(3)
  doctorEarning     Decimal?      @db.Decimal(12, 2)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  provider          String        @db.VarChar(50)
  providerReference String        @unique @db.VarChar(200)
  providerPaymentId String?       @unique @db.VarChar(200)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  booking           Booking?
  refund            RefundTransaction?
  client            User          @relation("ClientPayments", fields: [clientId], references: [id])

  @@index([clientId, status])
}

model RefundTransaction {
  id                String       @id @default(uuid()) @db.Uuid
  bookingId         String       @unique @db.Uuid
  paymentId         String       @unique @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @db.Char(3)
  status            RefundStatus @default(PENDING)
  providerReference String?      @unique @db.VarChar(200)
  attempts          Int          @default(0)
  nextAttemptAt     DateTime     @default(now()) @db.Timestamptz(3)
  lastErrorCode     String?      @db.VarChar(100)
  completedAt       DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  booking           Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

model DoctorPenalty {
  id        String        @id @default(uuid()) @db.Uuid
  doctorId  String        @db.Uuid
  bookingId String        @unique @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @db.Char(3)
  reason    String        @db.VarChar(120)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([doctorId, currency, createdAt])
}

model RescheduleRequest {
  id                String           @id @default(uuid()) @db.Uuid
  bookingId         String           @db.Uuid
  requesterId       String           @db.Uuid
  proposedStartTime DateTime         @db.Timestamptz(3)
  proposedEndTime   DateTime         @db.Timestamptz(3)
  status            RescheduleStatus @default(PENDING)
  reason            String?          @db.VarChar(500)
  respondedAt       DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requester         User             @relation("RescheduleRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  @@index([bookingId, status, createdAt])
  @@index([requesterId, status, createdAt])
}

model Earning {
  id        String        @id @default(uuid()) @db.Uuid
  doctorId  String        @db.Uuid
  bookingId String        @unique @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @db.Char(3)
  status    EarningStatus @default(PENDING)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  booking   Booking       @relation(fields: [bookingId], references: [id])
  reversal  EarningReversal?

  @@index([doctorId, status, currency])
}

model EarningReversal {
  id        String @id @default(uuid()) @db.Uuid
  earningId String @unique @db.Uuid
  amount    Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  earning   Earning @relation(fields: [earningId], references: [id], onDelete: Restrict)
}

model PayoutAccount {
  id                       String            @id @default(uuid()) @db.Uuid
  doctorId                 String            @db.Uuid
  type                     PayoutAccountType
  encryptedProviderDetails String
  displayLabel             String            @db.VarChar(120)
  isDefault                Boolean           @default(false)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)
  doctor                   DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  payouts                  PayoutTransaction[]

  @@index([doctorId, isDefault])
}

model PayoutTransaction {
  id                String        @id @default(uuid()) @db.Uuid
  doctorId          String        @db.Uuid
  payoutAccountId   String        @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  status            PayoutStatus  @default(PENDING)
  providerReference String?       @unique @db.VarChar(200)
  failureReason     String?       @db.VarChar(500)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?     @db.Timestamptz(3)
  doctor            DoctorProfile @relation(fields: [doctorId], references: [id])
  payoutAccount     PayoutAccount @relation(fields: [payoutAccountId], references: [id])

  @@index([doctorId, status, createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  scope        String   @db.VarChar(80)
  key          String   @db.VarChar(128)
  requestHash  String
  responseCode Int?
  responseBody Json?
  resourceId   String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
