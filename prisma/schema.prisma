generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  DOCTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum ProfessionalCategory {
  PSYCHIATRIST
  PSYCHOLOGIST
  COUNSELLOR
}

enum ProfessionalStatus {
  LICENSED_PROFESSIONAL
  FINAL_YEAR_STUDENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  DOCTOR_LOGIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  REVERSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutAccountType {
  BANK_ACCOUNT
  UPI
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  email                 String        @unique @db.VarChar(320)
  passwordHash          String
  role                   UserRole
  accountStatus          AccountStatus @default(ACTIVE)
  emailVerifiedAt        DateTime?     @db.Timestamptz(3)
  tokenVersion           Int           @default(0)
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?     @db.Timestamptz(3)
  doctorProfile          DoctorProfile?
  clientBookings         Booking[]     @relation("ClientBookings")
  refreshTokens          RefreshToken[]
  otpChallenges          OtpChallenge[]
  idempotencyRecords     IdempotencyRecord[]
  auditLogs              AuditLog[]    @relation("AuditActor")
  payments               Payment[]     @relation("ClientPayments")
}

model DoctorProfile {
  id                       String               @id @default(uuid()) @db.Uuid
  userId                   String               @unique @db.Uuid
  firstName                String               @db.VarChar(100)
  lastName                 String               @db.VarChar(100)
  dateOfBirth              DateTime             @db.Date
  phoneNumber              String               @unique @db.VarChar(32)
  professionalCategory     ProfessionalCategory
  professionalStatus       ProfessionalStatus
  verificationStatus       VerificationStatus   @default(PENDING)
  verificationSubmittedAt  DateTime?            @db.Timestamptz(3)
  verificationReason       String?              @db.VarChar(500)
  licenseNumber            String?              @unique @db.VarChar(100)
  licenseAuthority         String?              @db.VarChar(160)
  university               String?              @db.VarChar(200)
  course                   String?              @db.VarChar(200)
  specialization           String?              @db.VarChar(200)
  expectedGraduationDate   DateTime?            @db.Date
  enrollmentNumber         String?              @db.VarChar(100)
  timezone                 String               @default("UTC") @db.VarChar(64)
  bio                      String?              @db.VarChar(2000)
  profileImageUrl           String?              @db.VarChar(300)
  licenseDocumentUrl        String?              @db.VarChar(300)
  qualification            String?              @db.VarChar(200)
  institution              String?              @db.VarChar(200)
  graduationYear           Int?
  experienceYears          Int?
  languages                String[]             @default([])
  expertise                String[]             @default([])
  consultationFee          Decimal?             @db.Decimal(12, 2)
  emailNotifications       Boolean              @default(true)
  isAcceptingBookings      Boolean              @default(false)
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)
  user                     User                 @relation(fields: [userId], references: [id])
  workingHours             DoctorWorkingHour[]
  blockedSlots             DoctorBlockedSlot[]
  bookings                 Booking[]
  earnings                 Earning[]
  payoutAccounts           PayoutAccount[]
  payouts                  PayoutTransaction[]
  paymentOrders            Payment[] @relation("PaymentOrderDoctor")

  @@index([verificationStatus, isAcceptingBookings])
}

model OtpChallenge {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  purpose      OtpPurpose
  otpHash      String
  attempts     Int        @default(0)
  expiresAt    DateTime   @db.Timestamptz(3)
  lastSentAt   DateTime   @default(now()) @db.Timestamptz(3)
  consumedAt   DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  familyId       String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  replacedByHash String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model DoctorWorkingHour {
  id          String        @id @default(uuid()) @db.Uuid
  doctorId    String        @db.Uuid
  dayOfWeek   Int
  startTime   DateTime      @db.Time(0)
  endTime     DateTime      @db.Time(0)
  timezone    String        @db.VarChar(64)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, isActive])
}

model DoctorBlockedSlot {
  id          String        @id @default(uuid()) @db.Uuid
  doctorId    String        @db.Uuid
  startTime   DateTime      @db.Timestamptz(3)
  endTime     DateTime      @db.Timestamptz(3)
  reason      String?       @db.VarChar(500)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startTime, endTime])
}

model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  doctorId              String        @db.Uuid
  clientId              String        @db.Uuid
  startTime             DateTime      @db.Timestamptz(3)
  endTime               DateTime      @db.Timestamptz(3)
  sessionDurationMinutes Int
  bufferDurationMinutes  Int
  status                BookingStatus @default(PENDING)
  paymentId             String?       @unique @db.Uuid
  reservationExpiresAt  DateTime?      @db.Timestamptz(3)
  cancelledAt           DateTime?     @db.Timestamptz(3)
  completedAt           DateTime?     @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  doctor                DoctorProfile @relation(fields: [doctorId], references: [id])
  client                User          @relation("ClientBookings", fields: [clientId], references: [id])
  payment               Payment?      @relation(fields: [paymentId], references: [id])
  earning               Earning?

  @@index([doctorId, startTime])
  @@index([clientId, startTime])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  clientId          String        @db.Uuid
  doctorId          String?       @db.Uuid
  doctor            DoctorProfile? @relation("PaymentOrderDoctor", fields: [doctorId], references: [id], onDelete: Restrict, map: "Payment_order_doctor_fk")
  slotStart         DateTime?     @db.Timestamptz(3)
  slotEnd           DateTime?     @db.Timestamptz(3)
  expectedAmount    Decimal?      @db.Decimal(12, 2)
  expectedCurrency  String?       @db.Char(3)
  doctorEarning     Decimal?      @db.Decimal(12, 2)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  provider          String        @db.VarChar(50)
  providerReference String        @unique @db.VarChar(200)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  booking           Booking?
  client            User          @relation("ClientPayments", fields: [clientId], references: [id])

  @@index([clientId, status])
}

model Earning {
  id        String        @id @default(uuid()) @db.Uuid
  doctorId  String        @db.Uuid
  bookingId String        @unique @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @db.Char(3)
  status    EarningStatus @default(PENDING)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  booking   Booking       @relation(fields: [bookingId], references: [id])
  reversal  EarningReversal?

  @@index([doctorId, status, currency])
}

model EarningReversal {
  id        String @id @default(uuid()) @db.Uuid
  earningId String @unique @db.Uuid
  amount    Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  earning   Earning @relation(fields: [earningId], references: [id], onDelete: Restrict)
}

model PayoutAccount {
  id                       String            @id @default(uuid()) @db.Uuid
  doctorId                 String            @db.Uuid
  type                     PayoutAccountType
  encryptedProviderDetails String
  displayLabel             String            @db.VarChar(120)
  isDefault                Boolean           @default(false)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)
  doctor                   DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  payouts                  PayoutTransaction[]

  @@index([doctorId, isDefault])
}

model PayoutTransaction {
  id                String        @id @default(uuid()) @db.Uuid
  doctorId          String        @db.Uuid
  payoutAccountId   String        @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  status            PayoutStatus  @default(PENDING)
  providerReference String?       @unique @db.VarChar(200)
  failureReason     String?       @db.VarChar(500)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?     @db.Timestamptz(3)
  doctor            DoctorProfile @relation(fields: [doctorId], references: [id])
  payoutAccount     PayoutAccount @relation(fields: [payoutAccountId], references: [id])

  @@index([doctorId, status, createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  scope        String   @db.VarChar(80)
  key          String   @db.VarChar(128)
  requestHash  String
  responseCode Int?
  responseBody Json?
  resourceId   String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
