# Local Vite development proxy only. Set this to the new unified Render service.
# Never put backend secrets in frontend environment files.
DOCTOR_API_TARGET=https://antartalk-unified-backend.onrender.com
# To run against a local API instead, use http://127.0.0.1:4000

# Optional browser-visible production API origin. Leave blank for local Vite or
# when the deployed website reverse-proxies /api to the backend. Set it only when
# the deployed website calls a separate Render backend directly.
VITE_DOCTOR_API_ORIGIN=
